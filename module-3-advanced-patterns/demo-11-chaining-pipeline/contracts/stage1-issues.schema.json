{
  "title": "Stage 1 output: one issue per ticket",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["ticket_id", "category", "severity", "component", "summary"],
    "properties": {
      "ticket_id": {"type": "string", "pattern": "^#\\d+$"},
      "category": {"type": "string", "enum": ["bug", "data-quality", "fulfilment", "security", "feature-request", "praise", "performance"]},
      "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
      "component": {"type": "string", "enum": ["checkout", "payments", "search", "pricing", "notifications", "warehouse", "site", "recommendations"]},
      "summary": {"type": "string", "maxLength": 120}
    }
  }
}
